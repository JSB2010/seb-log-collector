# Copy to .env.local. Production reads these values from deployment and Secret Manager.
GOOGLE_CLOUD_PROJECT=your-project-id
LOG_BUCKET=your-private-log-bucket
PUBLIC_ORIGIN=https://your-cloud-run-service.run.app
UPLOAD_SIGNER_EMAIL=upload-signer@your-project-id.iam.gserviceaccount.com
SCHEDULER_EMAIL=maintenance@your-project-id.iam.gserviceaccount.com
SCHEDULER_AUDIENCE=https://your-cloud-run-service.run.app
ALLOWED_DOMAINS=example.org
SEED_ADMIN_EMAILS=it-admin@example.org
# Set only after configuring Google Auth Platform. Missing values disable sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-bytes
INTEGRATION_SECRET=
SOE_ADMIN_ORIGIN=
# Local synthetic testing only. Every dev bypass is rejected in production / Cloud Run.
DEV_AUTH=false
DEV_MEMORY=false
DEVICE_DAILY_BYTES=52428800
GLOBAL_DAILY_BYTES=10737418240
DEVICE_DAILY_OBJECTS=100
RETENTION_DAYS=90
